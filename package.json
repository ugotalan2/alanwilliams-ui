{
  "name": "@ugotalan2/ui",
  "version": "0.2.0",
  "description": "Shared AlanWilliams Apps frontend design system and React UI library",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/styles.css",
    "./icons/*": "./dist/icons/*"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && mkdir -p dist/styles dist/icons && cp src/styles/*.css dist/styles/ && cp src/icons/* dist/icons/",
    "prepack": "npm run build",
    "pack:local": "npm pack",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "peerDependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ugotalan2/alanwilliams-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
